<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/profileSetupRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:fillViewport="true"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <LinearLayout
        android:id="@+id/profileSetupContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/profile_setup_screen_padding">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="@dimen/profile_setup_back_size"
            android:layout_height="@dimen/profile_setup_back_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/profile_setup_back"
            android:padding="@dimen/profile_setup_back_icon_padding"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:id="@+id/tvProfileSetupTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/profile_setup_top_margin"
            android:text="@string/profile_setup_title"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvProfileSetupStep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/profile_setup_step"
            android:textColor="@color/brand_navy"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvProfileSetupSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/profile_setup_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardProfileForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/profile_setup_card_margin_top"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/border_light"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/profile_setup_card_padding">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilNickname"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/profile_setup_nickname_label"
                    app:boxBackgroundMode="outline"
                    app:boxBackgroundColor="@color/card_background"
                    app:boxCornerRadiusBottomEnd="@dimen/profile_setup_field_corner"
                    app:boxCornerRadiusBottomStart="@dimen/profile_setup_field_corner"
                    app:boxCornerRadiusTopEnd="@dimen/profile_setup_field_corner"
                    app:boxCornerRadiusTopStart="@dimen/profile_setup_field_corner"
                    app:boxStrokeColor="@color/text_input_box_stroke"
                    app:boxStrokeErrorColor="@color/input_error"
                    app:errorTextColor="@color/input_error"
                    app:helperText="@string/profile_setup_nickname_helper"
                    app:helperTextTextColor="@color/text_secondary"
                    app:hintAnimationEnabled="true"
                    app:hintEnabled="true"
                    app:hintTextColor="@color/text_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etNickname"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:inputType="textPersonName"
                        android:maxLength="12"
                        android:singleLine="true"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilMajor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/profile_setup_field_margin_top"
                    android:hint="@string/profile_setup_major_label"
                    app:boxBackgroundMode="outline"
                    app:boxBackgroundColor="@color/card_background"
                    app:boxCornerRadiusBottomEnd="@dimen/profile_setup_field_corner"
                    app:boxCornerRadiusBottomStart="@dimen/profile_setup_field_corner"
                    app:boxCornerRadiusTopEnd="@dimen/profile_setup_field_corner"
                    app:boxCornerRadiusTopStart="@dimen/profile_setup_field_corner"
                    app:boxStrokeColor="@color/text_input_box_stroke"
                    app:boxStrokeErrorColor="@color/input_error"
                    app:errorTextColor="@color/input_error"
                    app:hintAnimationEnabled="true"
                    app:hintEnabled="true"
                    app:hintTextColor="@color/text_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etMajor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:inputType="text"
                        android:maxLength="30"
                        android:singleLine="true"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilGrade"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/profile_setup_field_margin_top"
                    android:hint="@string/profile_setup_grade_label"
                    app:boxCornerRadiusBottomEnd="@dimen/profile_setup_field_corner"
                    app:boxCornerRadiusBottomStart="@dimen/profile_setup_field_corner"
                    app:boxCornerRadiusTopEnd="@dimen/profile_setup_field_corner"
                    app:boxCornerRadiusTopStart="@dimen/profile_setup_field_corner"
                    app:boxBackgroundColor="@color/card_background"
                    app:boxStrokeColor="@color/text_input_box_stroke"
                    app:boxStrokeErrorColor="@color/input_error"
                    app:errorTextColor="@color/input_error"
                    app:hintAnimationEnabled="true"
                    app:hintEnabled="true"
                    app:hintTextColor="@color/text_hint">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/actvGrade"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:singleLine="true"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilTargetCareer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/profile_setup_field_margin_top"
                    android:hint="@string/profile_setup_target_career_label"
                    app:boxBackgroundMode="outline"
                    app:boxBackgroundColor="@color/card_background"
                    app:boxCornerRadiusBottomEnd="@dimen/profile_setup_field_corner"
                    app:boxCornerRadiusBottomStart="@dimen/profile_setup_field_corner"
                    app:boxCornerRadiusTopEnd="@dimen/profile_setup_field_corner"
                    app:boxCornerRadiusTopStart="@dimen/profile_setup_field_corner"
                    app:boxStrokeColor="@color/text_input_box_stroke"
                    app:boxStrokeErrorColor="@color/input_error"
                    app:errorTextColor="@color/input_error"
                    app:hintAnimationEnabled="true"
                    app:hintEnabled="true"
                    app:hintTextColor="@color/text_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etTargetCareer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:inputType="text"
                        android:maxLength="30"
                        android:singleLine="true"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilInterestedIndustry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/profile_setup_field_margin_top"
                    android:hint="@string/profile_setup_industry_label"
                    app:boxBackgroundMode="outline"
                    app:boxBackgroundColor="@color/card_background"
                    app:boxCornerRadiusBottomEnd="@dimen/profile_setup_field_corner"
                    app:boxCornerRadiusBottomStart="@dimen/profile_setup_field_corner"
                    app:boxCornerRadiusTopEnd="@dimen/profile_setup_field_corner"
                    app:boxCornerRadiusTopStart="@dimen/profile_setup_field_corner"
                    app:boxStrokeColor="@color/text_input_box_stroke"
                    app:boxStrokeErrorColor="@color/input_error"
                    app:errorTextColor="@color/input_error"
                    app:hintAnimationEnabled="true"
                    app:hintEnabled="true"
                    app:hintTextColor="@color/text_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etInterestedIndustry"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:inputType="text"
                        android:maxLength="30"
                        android:singleLine="true"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilStrengths"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/profile_setup_field_margin_top"
                    android:hint="@string/profile_setup_strengths_label"
                    app:boxBackgroundMode="outline"
                    app:boxBackgroundColor="@color/card_background"
                    app:boxCornerRadiusBottomEnd="@dimen/profile_setup_field_corner"
                    app:boxCornerRadiusBottomStart="@dimen/profile_setup_field_corner"
                    app:boxCornerRadiusTopEnd="@dimen/profile_setup_field_corner"
                    app:boxCornerRadiusTopStart="@dimen/profile_setup_field_corner"
                    app:boxStrokeColor="@color/text_input_box_stroke"
                    app:boxStrokeErrorColor="@color/input_error"
                    app:counterEnabled="true"
                    app:counterMaxLength="100"
                    app:errorTextColor="@color/input_error"
                    app:hintAnimationEnabled="true"
                    app:hintEnabled="true"
                    app:hintTextColor="@color/text_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etStrengths"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:inputType="textMultiLine|textCapSentences"
                        android:maxLength="100"
                        android:minLines="3"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNextAssessment"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/profile_setup_button_height"
                    android:layout_marginTop="@dimen/profile_setup_button_margin_top"
                    android:text="@string/profile_setup_save_start"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/primary"
                    app:cornerRadius="@dimen/profile_setup_button_corner"
                    app:rippleColor="@color/primary_ripple" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
