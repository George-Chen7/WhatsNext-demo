<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvProfileSetupTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="填写个人信息"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvProfileSetupSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="用于生成更贴近你的职业分析报告"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/border_light"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="一、基础信息"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="姓名（昵称即可）"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusTopStart="14dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etNickname"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="性别"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rgGender"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbGenderFemale"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="女" />

                    <RadioButton
                        android:id="@+id/rbGenderMale"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:text="男" />

                    <RadioButton
                        android:id="@+id/rbGenderOther"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:text="其他" />
                </RadioGroup>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="出生年份"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusTopStart="14dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etBirthYear"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="4"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/border_light"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="二、教育背景"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="当前学历"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rgEducation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rbEducationHighSchool"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="高中" />

                    <RadioButton
                        android:id="@+id/rbEducationJuniorCollege"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="大专" />

                    <RadioButton
                        android:id="@+id/rbEducationBachelor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="本科" />

                    <RadioButton
                        android:id="@+id/rbEducationMaster"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="硕士" />

                    <RadioButton
                        android:id="@+id/rbEducationDoctor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="博士" />
                </RadioGroup>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="学校类型"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rgSchoolType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rbSchoolDoubleFirstClass"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="双一流" />

                    <RadioButton
                        android:id="@+id/rbSchoolRegularBachelor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="普通本科" />

                    <RadioButton
                        android:id="@+id/rbSchoolVocational"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="高职高专" />

                    <RadioButton
                        android:id="@+id/rbSchoolOverseas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="海外院校" />
                </RadioGroup>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="专业，例如计算机、会计、法学、医学、机械工程"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusTopStart="14dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etMajor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="年级"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rgGrade"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rbGradeFreshman"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="大一" />

                    <RadioButton
                        android:id="@+id/rbGradeSophomore"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="大二" />

                    <RadioButton
                        android:id="@+id/rbGradeJunior"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="大三" />

                    <RadioButton
                        android:id="@+id/rbGradeSenior"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="大四" />

                    <RadioButton
                        android:id="@+id/rbGradeMasterOne"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="研一" />
                </RadioGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/border_light"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="三、职业目标"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="毕业后的计划"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rgGraduationPlan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rbPlanEmployment"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="就业" />

                    <RadioButton
                        android:id="@+id/rbPlanPostgraduate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="考研" />

                    <RadioButton
                        android:id="@+id/rbPlanCivilService"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="考公" />

                    <RadioButton
                        android:id="@+id/rbPlanStartup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="创业" />

                    <RadioButton
                        android:id="@+id/rbPlanAbroad"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="出国" />

                    <RadioButton
                        android:id="@+id/rbPlanUnknown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="暂未确定" />
                </RadioGroup>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="希望从事的行业（多选）"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <CheckBox
                    android:id="@+id/cbIndustryIt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="IT互联网" />

                <CheckBox
                    android:id="@+id/cbIndustryFinance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="金融" />

                <CheckBox
                    android:id="@+id/cbIndustryEducation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="教育" />

                <CheckBox
                    android:id="@+id/cbIndustryMedical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="医疗" />

                <CheckBox
                    android:id="@+id/cbIndustryLaw"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="法律" />

                <CheckBox
                    android:id="@+id/cbIndustryManufacturing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="制造业" />

                <CheckBox
                    android:id="@+id/cbIndustryMedia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="传媒" />

                <CheckBox
                    android:id="@+id/cbIndustryGovernment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="政府机关" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="理想岗位 / 技能方向（多选）"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <CheckBox
                    android:id="@+id/cbPositionJava"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Java" />

                <CheckBox
                    android:id="@+id/cbPositionKotlin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Kotlin" />

                <CheckBox
                    android:id="@+id/cbPositionPython"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Python" />

                <CheckBox
                    android:id="@+id/cbPositionCpp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="C++" />

                <CheckBox
                    android:id="@+id/cbPositionOffice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Office" />

                <CheckBox
                    android:id="@+id/cbPositionPhotoshop"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Photoshop" />

                <CheckBox
                    android:id="@+id/cbPositionVideo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="视频剪辑" />

                <CheckBox
                    android:id="@+id/cbPositionData"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="数据分析" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="英语水平（可多选）"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <CheckBox
                    android:id="@+id/cbEnglishCet4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="CET4" />

                <CheckBox
                    android:id="@+id/cbEnglishCet6"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="CET6" />

                <CheckBox
                    android:id="@+id/cbEnglishIelts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="雅思" />

                <CheckBox
                    android:id="@+id/cbEnglishToefl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="托福" />

                <CheckBox
                    android:id="@+id/cbEnglishOther"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="其他" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNextAssessment"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="24dp"
                    android:text="保存并继续职业测评"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/primary"
                    app:cornerRadius="16dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
